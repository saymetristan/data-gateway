# ============================================================
# Espejo de variables para Railway (api + worker).
# Local: copiar a .env y llenar valores reales.
# Prod: mismas keys en Railway variables, cambiando DATABASE_URL
# por la connection string de Supabase data-ingest en SESSION pooler
# (puerto 5432, aws-1-us-east-1.pooler.supabase.com; pg-boss necesita
# session mode, no usar el transaction pooler 6543).
# PORT lo inyecta Railway.
# ============================================================

# Postgres (local: Docker Compose; prod: Supabase data-ingest)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/data_gateway
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# OpenRouter (LLM + embeddings)
# Local tests/CI can set USE_MOCK_PROVIDERS=true to avoid external API calls
OPENROUTER_API_KEY=sk-or-...
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SOFT_DEADLINE_MS=2500
EMBEDDING_HARD_TIMEOUT_MS=4000
EMBEDDING_MAX_RETRIES=1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
USE_MOCK_PROVIDERS=false

# Cifrado de credenciales de fuentes externas (generar: openssl rand -base64 32)
CREDENTIALS_ENCRYPTION_KEY=base64-32-bytes

# API
PORT=3000
ADMIN_API_KEY=dgw_admin_local_dev_key_change_me
PUBLIC_API_URL=https://data.whaapy.com
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Worker
# Ingest uses a larger provider/DB budget than the query path.
INGEST_EMBEDDING_SOFT_DEADLINE_MS=10000
INGEST_EMBEDDING_HARD_TIMEOUT_MS=60000
INGEST_EMBEDDING_MAX_RETRIES=2
INGEST_DATABASE_CONNECTION_TIMEOUT_MS=30000
INGEST_DATABASE_STATEMENT_TIMEOUT_MS=300000
# Keep total API + worker connections below the Supabase session-pooler limit (15).
EMBEDDING_JOB_CONCURRENCY=1
EMBEDDING_PROVIDER_CONCURRENCY=2
INGEST_DATABASE_POOL_MAX=1
WORKER_PGBOSS_POOL_MAX=3
# Incident switch: true keeps heartbeat/cache jobs running but pauses ingestion.
WORKER_INGESTION_PAUSED=false

# Entorno
NODE_ENV=development
